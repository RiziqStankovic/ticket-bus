# Server
PORT=5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ticket_bus"

# JWT
jwt_secret=your_super_secret_jwt_key_change_in_production

# Stripe (opsional - untuk pembayaran)
stripe_key=sk_test_your_stripe_key

# Email (untuk konfirmasi booking & reset password)
EMAIL=your_email@gmail.com
PASSWORD=your_app_password

# Frontend URL (untuk link reset password)
FRONTEND_URL=http://localhost:3000
